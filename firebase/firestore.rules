rules_version = '2';

/**
 * Firestore Security Rules — UNJBG PRE
 *
 * Principios de seguridad:
 * - user_scores: SOLO lectura del dueño. Escritura SOLO desde Cloud Functions (admin SDK).
 * - leaderboard: lectura pública autenticada, escritura SOLO desde Cloud Functions.
 * - examenes: lectura libre para gratuitos, escritura solo admin.
 * - Las colecciones de historial, progreso y flashcards son privadas al usuario.
 *
 * IMPORTANTE: Las actualizaciones de puntos y gamificación se hacen desde
 * Cloud Functions (updatePoints), nunca directamente desde el cliente.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ──────────────────────────────────────────────────────────────

    /** Verifica que el usuario esté autenticado */
    function isAuth() {
      return request.auth != null;
    }

    /** Verifica que es el dueño del documento */
    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    /** Verifica rol admin (custom claim o campo en Firestore) */
    function isAdmin() {
      return isAuth() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    /** Verifica si el usuario es premium */
    function isPremium() {
      return isAuth() &&
        exists(/databases/$(database)/documents/user_scores/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/user_scores/$(request.auth.uid)).data.isPremium == true;
    }

    // ─── Usuarios (identidad y roles) ─────────────────────────────────────────

    match /users/{userId} {
      // Lectura: cualquier autenticado puede ver perfiles (necesario para Leaderboard)
      allow read: if isAuth();
      // Creación: solo el propio usuario puede crear su perfil
      allow create: if isOwner(userId);
      // Actualización: el usuario puede actualizar su propio perfil EXCEPTO el campo 'role'
      // Solo el admin puede cambiar el rol
      allow update: if isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isPremium']);
      allow update: if isAdmin();
      // No se permite borrar usuarios
      allow delete: if false;
    }

    // ─── Exámenes ─────────────────────────────────────────────────────────────

    match /examenes/{examId} {
      // Lectura: todos los autenticados pueden leer exámenes gratuitos
      // Los premium/admin pueden leer todos
      allow read: if isAuth() && (
        !resource.data.keys().hasAny(['isPremium']) ||
        resource.data.isPremium != true ||
        isPremium() ||
        isAdmin()
      );
      // Escritura: solo admin
      allow write: if isAdmin();
    }

    match /examenes/{examId}/{document=**} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ─── Historial de exámenes ────────────────────────────────────────────────

    match /historial/{docId} {
      // Solo el dueño puede ver su historial
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      // El usuario puede crear su propio historial pero no puede modificar userId
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      // El usuario puede actualizar/borrar sus propios registros
      allow update, delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // ─── Flashcards (catálogo) ────────────────────────────────────────────────

    match /flashcards/{document=**} {
      // Todos los autenticados pueden leer el catálogo
      allow read: if isAuth();
      // Solo admin puede gestionar el catálogo
      allow write: if isAdmin();
    }

    // ─── Progreso de flashcards por usuario ───────────────────────────────────

    match /user_flashcards/{userId}/{document=**} {
      // Solo el dueño accede a su progreso de flashcards
      allow read, write: if isOwner(userId);
    }

    // ─── Lecciones completadas (teoría) ───────────────────────────────────────

    match /user_lessons/{userId}/completed/{lessonId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      // No se puede desmarcar una lección completada desde el cliente
      allow update, delete: if false;
    }

    // ─── GAMIFICACIÓN (user_scores) ───────────────────────────────────────────
    // CRÍTICO: Escritura bloqueada para el cliente.
    // Solo las Cloud Functions (Admin SDK) pueden escribir aquí.

    match /user_scores/{userId} {
      // El dueño puede leer sus propios puntos; admin puede leer todo
      allow read: if isOwner(userId) || isAdmin();
      // ❌ ESCRITURA BLOQUEADA PARA EL CLIENTE
      // La Cloud Function 'updatePoints' usa Admin SDK que bypasea estas reglas
      allow write: if false;
    }

    // ─── Leaderboard ──────────────────────────────────────────────────────────

    match /leaderboard/{userId} {
      // El leaderboard es público para todos los autenticados
      allow read: if isAuth();
      // ❌ ESCRITURA BLOQUEADA PARA EL CLIENTE (solo Cloud Functions)
      allow write: if false;
    }

    // ─── Estadísticas de carreras (datos históricos de ingreso) ───────────────

    match /carreras_stats/{carreraId} {
      // Lectura pública para autenticados (para la predicción)
      allow read: if isAuth();
      // Solo admin puede subir estadísticas
      allow write: if isAdmin();
    }

    // ─── Ingresantes históricos ────────────────────────────────────────────────

    match /ingresantes_historicos/{docId} {
      // Solo admin puede leer/escribir los históricos raw
      allow read, write: if isAdmin();
    }

    // ─── Control de uploads de estadísticas ───────────────────────────────────

    match /uploads_stats/{uploadId} {
      allow read, write: if isAdmin();
    }

    // ─── Teoría (contenido educativo) ─────────────────────────────────────────

    match /teoria/{document=**} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ─── Regla por defecto ────────────────────────────────────────────────────
    // Denegar todo lo que no esté explícitamente permitido arriba

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
