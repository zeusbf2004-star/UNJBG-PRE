rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar para saber si es el Admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Función auxiliar para saber si es Premium
    function isPremium() {
      return request.auth != null && (
        exists(/databases/$(database)/documents/user_scores/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/user_scores/$(request.auth.uid)).data.isPremium == true
      );
    }

    // Colección users: Identidad y Roles
    match /users/{userId} {
      // Cualquier usuario autenticado puede ver el perfil básico de otros (para Leaderboard)
      allow read: if request.auth != null;
      // Solo el Admin puede cambiar el rol. El usuario puede actualizar sus propios datos de perfil.
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) ||
        isAdmin()
      );
    }

    // Colección examenes: Acceso a exámenes gratuitos, o todos si es premium/admin
    match /examenes/{document=**} {
      allow read: if isAdmin() || (resource.data.isPremium != true) || isPremium();
      allow write: if isAdmin();
    }

    // Colección historial: Usuarios solo leen/escriben sus propios resultados
    match /historial/{docId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Colección flashcards: Todos los autenticados pueden leer, solo admin puede escribir
    match /flashcards/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Progreso de flashcards por usuario: Solo el usuario dueño puede leer/escribir
    match /user_flashcards/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Estadísticas de usuario: Solo el usuario dueño puede leer/escribir
    match /user_stats/{userId}/{document=**} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Perfil de gamificación y suscripción: El usuario lee/escribe el suyo, Admin lee todo
    match /user_scores/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Por defecto, cualquier otra colección/documento: Solo el admin tiene acceso total
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
